    "---\n",
    "## Task 1: Image Manipulation Basics\n",
    "Remove this cell if you're not completing this task."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7718ffa0",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np
from PIL import Image

import matplotlib.pyplot as plt

# Load an image
image_path = "image.jpg"  # Replace with your image path
image = Image.open(image_path)
image_array = np.array(image)

print(f"Original image shape: {image_array.shape}")
print(f"Image dtype: {image_array.dtype}")

# 1. Convert to grayscale
if len(image_array.shape) == 3:
    grayscale = np.dot(image_array[..., :3], [0.299, 0.587, 0.114])
else:
    grayscale = image_array
grayscale = grayscale.astype(np.uint8)

# 2. Rotate image by 90 degrees
rotated = np.rot90(image_array, k=1)  # k=1 for 90 degrees

# 3. Flip horizontally and vertically
flipped_horizontal = np.fliplr(image_array)
flipped_vertical = np.flipud(image_array)

# 4. Crop a region of interest (example: center crop)
height, width = image_array.shape[:2]
crop_height, crop_width = height // 2, width // 2
start_y, start_x = height // 4, width // 4
cropped = image_array[start_y:start_y + crop_height, start_x:start_x + crop_width]

# 5. Display original and processed images
fig, axes = plt.subplots(2, 3, figsize=(15, 10))

axes[0, 0].imshow(image_array)
axes[0, 0].set_title("Original Image")
axes[0, 0].axis("off")

axes[0, 1].imshow(grayscale, cmap="gray")
axes[0, 1].set_title("Grayscale")
axes[0, 1].axis("off")

axes[0, 2].imshow(rotated)
axes[0, 2].set_title("Rotated 90°")
axes[0, 2].axis("off")

axes[1, 0].imshow(flipped_horizontal)
axes[1, 0].set_title("Flipped Horizontal")
axes[1, 0].axis("off")

axes[1, 1].imshow(flipped_vertical)
axes[1, 1].set_title("Flipped Vertical")
axes[1, 1].axis("off")

axes[1, 2].imshow(cropped)
axes[1, 2].set_title("Cropped ROI")
axes[1, 2].axis("off")

plt.tight_layout()
plt.show()

# 6. Save processed images
Image.fromarray(grayscale).save("grayscale.jpg")
Image.fromarray(rotated.astype(np.uint8)).save("rotated.jpg")
Image.fromarray(flipped_horizontal.astype(np.uint8)).save("flipped_horizontal.jpg")
Image.fromarray(flipped_vertical.astype(np.uint8)).save("flipped_vertical.jpg")
Image.fromarray(cropped.astype(np.uint8)).save("cropped.jpg")

print("Images saved successfully!")"
