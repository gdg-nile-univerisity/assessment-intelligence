   "source": [
    """"Linear Regression using Gradient Descent

This script implements a simple linear regression model from scratch using
numpy for matrix operations and matplotlib for visualization. The process
includes:

1. Generating a synthetic dataset
2. Defining the cost function (mean squared error)
3. Implementing gradient descent to update parameters
4. Training the model and monitoring convergence
5. Evaluating the model with R² score
6. Plotting cost history and fitted line vs data

"""

import numpy as np
import matplotlib.pyplot as plt

# Set random seed for reproducibility - ensures consistent results across runs
np.random.seed(42)


 
# SECTION 1: Generate a simple synthetic dataset

# Create synthetic data with a known linear relationship (y = b + m*x + noise)
# This allows us to verify that our algorithm can recover the true parameters

n_samples = 100  # Number of data points
X = 2 * np.random.rand(n_samples, 1)  # Single feature uniformly distributed in [0, 2]

# Define the true underlying linear relationship (y = intercept + slope*x + noise)
true_slope = 3.5  # True slope parameter
true_intercept = 1.2  # True intercept (bias) parameter
noise = np.random.randn(n_samples, 1) * 0.8  # Add Gaussian noise

# Generate target values with noise
y = true_intercept + true_slope * X + noise


 
# SECTION 2: Prepare data
 
# Add bias term (column of ones) to X for joint parameter estimation
# This allows us to learn both intercept and slope in one weight vector
X_b = np.c_[np.ones((n_samples, 1)), X]  # Shape: (n_samples, 2)

# Reshape y to column vector for matrix operations
y_vector = y.reshape(-1, 1)  # Shape: (n_samples, 1)



# SECTION 3: Initialize parameters

# Initialize weight vector to zeros (both intercept and slope)
# theta[0] = intercept (bias), theta[1] = slope (weight for feature)
theta = np.zeros((2, 1))  # Shape: (2, 1)

# Learning rate controls step size in gradient descent
# Too large: may overshoot and diverge; too small: slow convergence
learning_rate = 0.1

# Number of iterations to run gradient descent
epochs = 1000

# Track cost at each epoch for convergence monitoring
cost_history = []

 

# SECTION 4: Cost function (Mean Squared Error)

# MSE = (1 / 2m) * Σ(ŷ - y)²
# where ŷ are predictions, y are true targets, and m is number of samples
# Lower cost indicates better fit
def compute_cost(X, y, theta):
    """
    Compute the mean squared error cost.
    
    Args:
        X: Design matrix with bias term (n_samples, 2)
        y: Target vector (n_samples, 1)
        theta: Parameter vector (2, 1)
    
    Returns:
        cost: Scalar MSE value
    """
    m = len(y)  # Number of samples
    predictions = X.dot(theta)  # ŷ = X @ θ
    error = predictions - y  # Residuals
    cost = (1 / (2 * m)) * np.sum(error ** 2)  # MSE formula
    return cost



# SECTION 5: Gradient descent step

# Update rule: θ = θ - α * ∇J(θ)
# where α is learning rate and ∇J(θ) = (1/m) * X^T @ (ŷ - y)
# Gradient points in direction of steepest ascent; we subtract to descend
def gradient_step(X, y, theta, lr):
    """
    Perform one step of gradient descent.
    
    Args:
        X: Design matrix with bias term (n_samples, 2)
        y: Target vector (n_samples, 1)
        theta: Current parameter vector (2, 1)
        lr: Learning rate (step size)
    
    Returns:
        theta: Updated parameter vector
    """
    m = len(y)  # Number of samples
    predictions = X.dot(theta)  # ŷ = X @ θ
    error = predictions - y  # Residuals (ŷ - y)
    gradients = (1 / m) * X.T.dot(error)  # Gradient = (1/m) * X^T @ error
    theta = theta - lr * gradients  # Update parameters
    return theta



# SECTION 6: Training loop with convergence monitoring

# Repeatedly apply gradient descent steps for the specified number of epochs
# Monitor cost to verify that it decreases (indicates convergence)
for epoch in range(epochs):
    # Update parameters using gradient descent
    theta = gradient_step(X_b, y_vector, theta, learning_rate)
    
    # Compute and record cost for this epoch
    cost = compute_cost(X_b, y_vector, theta)
    cost_history.append(cost)
    
    # Print progress every 100 epochs
    if epoch % 100 == 0:
        print(f"Epoch {epoch:4d} | Cost {cost:.4f}")

print("Training finished.")
# Display learned parameters (should be close to true_intercept=1.2, true_slope=3.5)
print("Estimated parameters:", theta.ravel())



# SECTION 7: Evaluate model (R² score)

# R² = 1 - (SS_res / SS_tot)
# SS_res = Σ(y - ŷ)² (sum of squared residuals)
# SS_tot = Σ(y - ȳ)² (total sum of squares)
# R² measures proportion of variance in y explained by model
# Range: 0 to 1, where 1 indicates perfect fit

predictions = X_b.dot(theta)  # Final predictions on training data
ss_res = np.sum((y_vector - predictions) ** 2)  # Sum of squared residuals
ss_tot = np.sum((y_vector - np.mean(y_vector)) ** 2)  # Total sum of squares
r2_score = 1 - (ss_res / ss_tot)  # Calculate R² score
print(f"R² score on training set: {r2_score:.4f}")



# SECTION 8: Visualize results

# Create a figure with two subplots:
# Left: Cost history (convergence curve)
# Right: Data points and fitted regression line

plt.figure(figsize=(12, 5))

# Subplot 1: Cost vs iterations
# Shows how MSE decreases as optimization progresses
plt.subplot(1, 2, 1)
plt.plot(cost_history, linewidth=2)
plt.xlabel('Iteration', fontsize=11)
plt.ylabel('Cost (MSE)', fontsize=11)
plt.title('Cost vs. Iterations (Convergence)', fontsize=12, fontweight='bold')
plt.grid(True, alpha=0.3)

# Subplot 2: Data points and fitted line
# Blue dots: original training data
# Red line: learned linear fit
plt.subplot(1, 2, 2)
plt.scatter(X, y, alpha=0.6, label='Data', s=50)
plt.plot(X, predictions, color='red', linewidth=2.5, label='Fitted line')
plt.xlabel('Feature x', fontsize=11)
plt.ylabel('Target y', fontsize=11)
plt.title('Data and Linear Fit', fontsize=12, fontweight='bold')
plt.legend(fontsize=10)
plt.grid(True, alpha=0.3)

plt.tight_layout()
plt.show()
"
